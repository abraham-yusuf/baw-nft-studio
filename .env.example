# ==============================================================================
# BAW NFT STUDIO — ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: The core system is designed with a "Zero-Setup Fallback" principle:
# It works 100% out-of-the-box using permissionless on-chain RPC nodes and BAW CLI.
# Setting the API keys below is OPTIONAL, but unlocks high-speed indexing,
# live marketplace floor prices, and automatic orderbook broadcasting.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & RPC ENDPOINTS
# ------------------------------------------------------------------------------
# Default BSC RPC: Public Binance Dataseed (No API key needed).
# For production or high-throughput, you can use Alchemy, QuickNode, or Ankr.
BSC_RPC_URL="https://bsc-dataseed.binance.org/"
FALLBACK_BSC_RPCS="https://bsc-dataseed1.defibit.io/,https://bsc-dataseed1.ninicoin.io/"

# ------------------------------------------------------------------------------
# 2. EXPLORER & INDEXER API KEYS
# ------------------------------------------------------------------------------
# BscScan / Etherscan API Key (Get free at https://bscscan.com/myapikey)
# Unlocks high-rate transaction history and instant ERC-721 token inventory.
BSCSCAN_API_KEY=""

# ------------------------------------------------------------------------------
# 3. MARKETPLACE & ORDERBOOK BROADCASTING APIS
# ------------------------------------------------------------------------------
# Element Market API Key (Get at https://element.market/developer)
# Allows auto-broadcasting your signed EIP-712 listing orders directly to Element BSC.
ELEMENT_API_KEY=""

# Reservoir API Key (Get free at https://reservoir.tools)
# Aggregates live floor prices, top bids, and orderbook across all BSC NFT marketplaces.
RESERVOIR_API_KEY=""

# SimpleHash API Key (Get free at https://simplehash.com)
# Provides real-time NFT metadata, rarity ranks, and floor prices.
SIMPLEHASH_API_KEY=""

# ------------------------------------------------------------------------------
# 4. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8090
HOST="0.0.0.0"
